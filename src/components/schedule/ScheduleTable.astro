---
import { schedule } from "@/data/site";

const times = [
  "7h",
  "9h",
  "10h",
  "11h",
  "12h",
  "17h",
  "17h30",
  "18h15",
  "18h30",
  "19h",
  "19h30",
  "20h",
];
const classesAt = (dayIndex: number, time: string) =>
  schedule[dayIndex]?.slots.filter((slot) => slot.time === time) ?? [];
---

<div class="schedule-table-wrap" data-reveal>
  <table class="schedule-table">
    <thead>
      <tr>
        <th scope="col">Hora</th>
        {schedule.map((day) => <th scope="col">{day.day}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        times.map((time) => (
          <tr>
            <th scope="row">{time}</th>
            {schedule.map((_, dayIndex) => (
              <td>
                {classesAt(dayIndex, time).map((slot) => (
                  <span class="class-chip">{slot.name}</span>
                ))}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
