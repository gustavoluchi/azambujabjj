---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
  <div class="shell page-hero__inner">
    <p class="eyebrow eyebrow--light">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
