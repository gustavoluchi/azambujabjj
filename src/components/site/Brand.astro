---
import logo from "@/assets/reference/logo-azambuja.png";
import { Image } from "astro:assets";

interface Props {
  href?: string;
  compact?: boolean;
}

const { href = "/", compact = false } = Astro.props;
---

<a
  class:list={["brand", { "brand--compact": compact }]}
  href={href}
  aria-label="Azambuja Jiu Jitsu — página inicial"
>
  <Image src={logo} alt="" width={52} height={52} loading="eager" />
  <span class="brand__copy">
    <strong>Azambuja</strong>
    <span>Jiu Jitsu · Porto Alegre</span>
  </span>
</a>
