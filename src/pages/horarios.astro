---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import ScheduleTable from "@/components/schedule/ScheduleTable.astro";
import { bookingUrl } from "@/data/site";
const gradeHorarios = "/gradehorarios.jpeg";
---

<Layout
  title="Horários"
  description="Confira a grade de horários da Escola Azambuja."
  canonicalPath="/horarios"
>
  <main id="conteudo">
    <PageHero
      eyebrow="Grade semanal"
      title="Encontre seu horário de treino"
      description="Turmas para diferentes idades e níveis, com frequência livre nos planos de jiu jitsu."
    />
    <section class="content-section">
      <div class="shell">
        <div class="detail-actions" style="margin: 0 0 2rem">
          <a
            class="button button--primary"
            href={gradeHorarios}
            download="grade-horarios-azambuja.jpeg">Grade para download</a
          ><a
            class="text-link"
            href={gradeHorarios}
            target="_blank"
            rel="noopener noreferrer">Abrir como imagem</a
          >
        </div>
        <ScheduleTable />
        <p style="color: var(--muted); margin: 1.5rem 0 0">
          Quarta-feira é dia de No Gi, exceto para a turma feminina das 9h.
          Confirme alterações pontuais diretamente com a equipe.
        </p>
        <div class="detail-actions">
          <a
            class="button button--primary"
            href={bookingUrl}
            target="_blank"
            rel="noopener noreferrer">Agendar aula experimental</a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>
