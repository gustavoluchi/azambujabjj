---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import RafaelFoto from "@/assets/reference/rafael-azambuja.jpg";
import { Image } from "astro:assets";
import { timeline } from "@/data/site";
---

<Layout
  title="Rafael Azambuja"
  description="Conheça a trajetória do fundador e coordenador técnico Rafael Azambuja."
  canonicalPath="/rafael-azambuja"
>
  <main id="conteudo">
    <PageHero
      eyebrow="Fundador e coordenador técnico"
      title="Rafael Azambuja"
      description="Faixa preta 5º grau, professor e responsável pela aplicação do Sistema Progressivo em toda a escola."
    />
    <section class="content-section">
      <div class="shell media-copy">
        <Image
          src={RafaelFoto}
          alt="Professor Rafael Azambuja"
          width={720}
          height={900}
          loading="eager"
        />
        <div class="prose" data-reveal>
          <h2>Do primeiro treino à formação de novas escolas</h2>
          <blockquote>
            Comecei no jiu-jitsu em 1997. No início de 1998 encontrei a Winner
            Behring, sob o comando do professor Márcio Corleta, e conheci o
            Sistema Progressivo de Jiu-Jitsu.
          </blockquote>
          <p>
            Rafael permaneceu dez anos na Winner Behring e recebeu a faixa preta
            em 2005. Em 2007 iniciou uma nova etapa ao fundar a Escola Azambuja
            com Gabriel Azambuja, sob a tutela do Mestre Sylvio Behring.
          </p>
          <p>
            Desde então, a escola formou 24 faixas pretas e deu origem a
            diversas outras escolas, mantendo a avaliação individual e a
            progressão técnica como pilares do ensino.
          </p>
        </div>
      </div>
    </section>
    <section class="content-section content-section--white">
      <div class="shell">
        <header class="section-heading">
          <p class="eyebrow">Trajetória competitiva</p><h2>
            Resultados construídos ao longo do caminho
          </h2>
        </header><ol class="timeline" data-reveal>
          {
            timeline.map(([year, achievement]) => (
              <li>
                <>
                  <time>{year}</time>
                  <p>{achievement}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>
</Layout>
