---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";

const branches = [
  {
    name: "Azambuja Serra",
    tag: "Filial",
    teacher: "Adryan Carvalho",
    address: "Rua Renânia, 66 · Centro · Nova Petrópolis/RS · CEP 95150-000",
    phone: "55 99675-9530",
    whatsapp: "555599675953",
    map: "https://www.google.com/maps?q=Rua+Renania,+66,+Nova+Petrópolis,+RS,+95150-000&output=embed",
  },
  {
    name: "Lomba do Pinheiro",
    tag: "Filial",
    teacher: "Guilherme Rodrigues",
    address: "Av. João de Oliveira Remião, 3322 · Parada 7 · Porto Alegre/RS",
    phone: "51 99247-7012",
    whatsapp: "5551992477012",
    map: "https://www.google.com/maps?q=Av.+João+de+Oliveira+Remião,+3322,+Lomba+do+Pinheiro,+Porto+Alegre,+RS&output=embed",
  },
  {
    name: "Projeto de Extensão IFSul",
    tag: "Projeto social",
    teacher: "Ramiro Barcos",
    address: "Rua Men de Sá, 800 · Bom Sucesso · Gravataí/RS · CEP 94135-300",
    phone: "51 99233-8537",
    whatsapp: "5551992338537",
    map: "https://www.google.com/maps?q=R.+Men+de+Sá,+800,+Bom+Sucesso,+Gravataí,+RS,+94135-300&output=embed",
  },
];
---

<Layout
  title="Filiais"
  description="Conheça as filiais e o projeto social ligados à Escola Azambuja."
  canonicalPath="/filiais"
>
  <main id="conteudo">
    <PageHero
      eyebrow="Nossa rede"
      title="O Sistema Progressivo em mais lugares"
      description="Cada unidade tem sua própria gestão, mantendo o compromisso com ensino técnico, seguro e acolhedor."
    />
    <section class="content-section">
      <div class="shell locations-grid">
        {
          branches.map((branch) => (
            <article class="location-item" data-reveal>
              <>
                <span class="tag">{branch.tag}</span>
                <h2 style="font-size: 1.2rem">{branch.name}</h2>
                <p class="teacher">Professor {branch.teacher}</p>
                <address>{branch.address}</address>
                <div class="detail-actions">
                  <a
                    class="button button--primary"
                    href={`https://wa.me/${branch.whatsapp}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-umami-event="contato-filial"
                  >
                    WhatsApp {branch.phone}
                  </a>
                </div>
                <iframe
                  class="map-frame"
                  src={branch.map}
                  allowfullscreen
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Mapa da ${branch.name}`}
                />
              </>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
