---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import { bookingUrl, contact } from "@/data/site";
---

<Layout
  title="Contato"
  description="Fale com a Escola Azambuja e conheça nossa matriz no bairro Bom Fim."
  canonicalPath="/contato"
>
  <main id="conteudo">
    <PageHero
      eyebrow="Porto Alegre"
      title="Entre em contato com a Azambuja"
      description="Tire suas dúvidas ou agende uma aula experimental gratuita na nossa matriz do Bom Fim."
    />
    <section class="content-section">
      <div class="shell contact-grid">
        <div data-reveal>
          <div class="contact-list">
            <a
              href="https://wa.me/5551980267688"
              target="_blank"
              rel="noopener noreferrer"
              ><strong>WhatsApp</strong><span>{contact.phone}</span></a
            >
            <a
              href={contact.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              ><strong>Instagram</strong><span>{contact.instagram}</span></a
            >
            <a href={`mailto:${contact.email}`}
              ><strong>E-mail</strong><span>{contact.email}</span></a
            >
            <a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer"
              ><strong>Endereço</strong><span
                >{contact.address}<br />CEP 90035-191</span
              ></a
            >
          </div><div class="detail-actions">
            <a
              class="button button--primary"
              href={bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="agendar-contato">Agendar aula gratuita</a
            >
          </div>
        </div>
        <iframe
          class="map-frame"
          style="height: 28rem; margin-top: 0"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3454.1069427636658!2d-51.21689218712032!3d-30.033789630681063!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95197972651a453b%3A0x1195870ed3ae9c84!2sEscola%20de%20Jiu-Jitsu%20Azambuja!5e0!3m2!1spt-BR!2sbr!4v1736881101041!5m2!1spt-BR!2sbr"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa da Escola Azambuja, Av. Osvaldo Aranha, 794"></iframe>
      </div>
    </section>
  </main>
</Layout>
